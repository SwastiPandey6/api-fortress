# ---------------------------------------------------------------------------
# API Fortress configuration
# Copy this file to `.env` (setup scripts do it for you) and edit as needed.
# Generate production secrets with:  python scripts/generate_secrets.py
# ---------------------------------------------------------------------------

# development | production   (production refuses to start with weak secrets)
APP_ENV=development

# --- Admin console ---------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_SESSION_SECRET=dev-admin-session-secret-change-me-0123456789
SESSION_TTL_MINUTES=480
# Set to true when the dashboard is served over HTTPS
COOKIE_SECURE=false

# --- Shared between gateway and protected API --------------------------------
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ISSUER=api-fortress-demo
JWT_AUDIENCE=demo-api
GATEWAY_SHARED_SECRET=dev-gateway-shared-secret-change-me

# --- Gateway -------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:9000
GATEWAY_SELF_URL=http://127.0.0.1:8000
# learning | monitor | enforce
GATEWAY_MODE=enforce
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BODY_BYTES=1048576
PUBLIC_PATHS=/auth/login,/health
# true only when running behind a reverse proxy you control (Caddy, Nginx, Render)
TRUST_PROXY_HEADERS=false

# --- Storage -----------------------------------------------------------------------
# Leave empty for SQLite at data/fortress.db. For Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/fortress
DATABASE_URL=

# --- Log shipping (scripts/ship_logs.py). Empty disables the push endpoint. ------------
INGEST_TOKEN=
